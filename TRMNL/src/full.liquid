<div class="layout layout--col gap--small" aria-label="{{ pet.status | escape }}">
  <div class="flex flex--center grow w--full">
    <svg class="w--full h--[70cqh]" viewBox="0 0 32 24" role="img" aria-label="{{ pet.status | escape }}" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">
      <g transform="{{ pet.sprite_transform | escape }}"><path d="{{ pet.sprite_path | escape }}" fill="currentColor"/></g>
      <g transform="translate(24 1)"><path d="{{ pet.sleep_path | escape }}" fill="currentColor"/></g>
    </svg>
  </div>
  <div class="grid grid--cols-3 w--full gap--small">
    <div class="flex flex--row flex--left gap--small"><img class="w--7 h--7" src="data:image/svg+xml;base64,{{ svg_food | base64_encode }}" alt=""><svg class="w--20 h--5" viewBox="0 0 36 8" role="img" aria-label="Food: {{ pet.food | escape }}" shape-rendering="crispEdges"><path d="{{ pet.food_path | escape }}" fill="currentColor" fill-rule="evenodd"/></svg></div>
    <div class="flex flex--row flex--center gap--small"><img class="w--7 h--7" src="data:image/svg+xml;base64,{{ svg_joy | base64_encode }}" alt=""><svg class="w--20 h--5" viewBox="0 0 36 8" role="img" aria-label="Joy: {{ pet.joy | escape }}" shape-rendering="crispEdges"><path d="{{ pet.joy_path | escape }}" fill="currentColor" fill-rule="evenodd"/></svg></div>
    <div class="flex flex--row flex--right"><span class="label">{{ pet.age | escape }}</span></div>
  </div>
  <span class="label {{ pet.notice_visibility | escape }}">{{ pet.notice | escape }}</span>
</div>
<div class="title_bar">
  <img class="image" width="24" height="24" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="">
  <span class="title">TRMNLGotchi</span>
  <span class="instance">{{ pet.name | escape }} · {{ pet.stage | escape }} · Gen {{ pet.generation | escape }}</span>
</div>
