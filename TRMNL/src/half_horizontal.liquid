<div class="layout layout--col gap--small" aria-label="{{ pet.status | escape }}">
  <div class="flex flex--center grow w--full">
    <svg class="w--full h--[60cqh]" viewBox="0 0 32 24" role="img" aria-label="{{ pet.status | escape }}" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">
      <g transform="{{ pet.sprite_transform | escape }}"><path d="{{ pet.sprite_path | escape }}" fill="currentColor"/></g>
      <g transform="translate(24 1)"><path d="{{ pet.sleep_path | escape }}" fill="currentColor"/></g>
    </svg>
  </div>
  <div class="flex flex--row flex--between w--full gap--small">
    <div class="flex flex--row gap--small"><span class="label label--small">FOOD</span><svg class="w--16 h--4" viewBox="0 0 36 8" role="img" aria-label="Food: {{ pet.food | escape }}" shape-rendering="crispEdges"><path d="{{ pet.food_path | escape }}" fill="currentColor" fill-rule="evenodd"/></svg></div>
    <div class="flex flex--row gap--small"><span class="label label--small">JOY</span><svg class="w--16 h--4" viewBox="0 0 36 8" role="img" aria-label="Joy: {{ pet.joy | escape }}" shape-rendering="crispEdges"><path d="{{ pet.joy_path | escape }}" fill="currentColor" fill-rule="evenodd"/></svg></div>
    <span class="label label--small">{{ pet.age | escape }}</span>
  </div>
  <span class="label label--small {{ pet.notice_visibility | escape }}">{{ pet.notice | escape }}</span>
</div>
<div class="title_bar">
  <svg class="image" width="24" height="24" viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges"><path d="{{ pet.logo_path | escape }}" fill="currentColor"/></svg>
  <span class="title">TAMAGOTCHI</span>
  <span class="instance">{{ pet.name | escape }} · {{ pet.stage | escape }} · Gen {{ pet.generation | escape }}</span>
</div>
