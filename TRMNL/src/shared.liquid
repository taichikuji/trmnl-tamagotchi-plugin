{% comment %}Render scopes are isolated: callers pass all data, icons and size classes explicitly.{% endcomment %}
{% template pet_content %}
  <div class="flex flex--center grow w--full">
    <svg class="w--full {{ sprite_size | escape }}" viewBox="0 0 32 24" role="img" aria-label="{{ pet.status | escape }}" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">
      <g transform="{{ pet.sprite_transform | escape }}"><path d="{{ pet.sprite_path | escape }}" fill="currentColor"/></g>
      <g transform="translate(24 1)"><path d="{{ pet.sleep_path | escape }}" fill="currentColor"/></g>
      <g transform="translate(24 12)"><path d="{{ pet.poop_path | escape }}" fill="currentColor"/></g>
      <g transform="translate(27 2)"><path d="{{ pet.discipline_path | escape }}" fill="currentColor"/></g>
    </svg>
  </div>
  <div class="grid grid--cols-3 portrait:grid--cols-2 w--full gap--small">
    <div class="flex flex--row flex--left gap--small"><svg class="{{ icon_size | escape }}" viewBox="0 0 75 75" fill="currentColor" aria-hidden="true">{{ svg_food }}</svg><svg class="{{ hearts_size | escape }}" viewBox="0 0 36 8" role="img" aria-label="Food: {{ pet.food | escape }}" shape-rendering="crispEdges"><path d="{{ pet.food_path | escape }}" fill="currentColor" fill-rule="evenodd"/></svg></div>
    <div class="flex flex--row flex--center portrait:flex--right gap--small"><svg class="{{ icon_size | escape }}" viewBox="0 0 75 75" fill="currentColor" fill-rule="evenodd" aria-hidden="true">{{ svg_joy }}</svg><svg class="{{ hearts_size | escape }}" viewBox="0 0 36 8" role="img" aria-label="Joy: {{ pet.joy | escape }}" shape-rendering="crispEdges"><path d="{{ pet.joy_path | escape }}" fill="currentColor" fill-rule="evenodd"/></svg></div>
    <div class="flex flex--row flex--right portrait:col--span-2 portrait:flex--center"><span class="label lg:label--large">{{ pet.age | escape }}</span></div>
  </div>
  <span class="label {{ label_size | escape }} {{ pet.notice_visibility | escape }}">{{ pet.notice | escape }}</span>
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
  <svg class="image" width="24" height="24" viewBox="83.274 6.4476 26 26" fill="currentColor" aria-hidden="true">{{ svg_logo }}</svg>
  <span class="title">{{ title | escape }}</span>
  <span class="instance">{% unless compact %}{{ pet.name | escape }} · {{ pet.stage | escape }} · {% endunless %}Gen {{ pet.generation | escape }}</span>
</div>
{% endtemplate %}
